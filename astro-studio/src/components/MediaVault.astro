---
// MediaVault.astro - Persistent video catalog from SQLite
---
<div class="flex items-center justify-between mb-6">
  <div>
    <h2 class="text-xl font-black text-white flex items-center gap-2">
      <span>🎞️</span> Persistent Media Vault
    </h2>
    <p class="text-xs text-slate-400 mono mt-1">Indexed in SQLite (<code class="text-cyan-400">vortex.db</code>)</p>
  </div>
  <button onclick="loadVaultHistory()" class="liquid-pill px-4 py-2 rounded-xl text-xs font-semibold text-cyan-300 flex items-center gap-2">
    <span>🔄</span> Refresh Catalog
  </button>
</div>

<!-- Catalog Grid -->
<div id="vaultGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  
  <!-- Sample Video Card 1 -->
  <div class="liquid-glass p-5 rounded-3xl spatial-card flex flex-col justify-between">
    <div class="specular-sheen"></div>
    <div>
      <div class="aspect-[9/16] w-full max-h-56 bg-black rounded-2xl overflow-hidden relative mb-4 border border-white/10">
        <video src="/video" class="w-full h-full object-cover" muted onmouseover="this.play()" onmouseout="this.pause()"></video>
        <span class="absolute top-2 left-2 bg-black/80 px-2 py-0.5 rounded text-[10px] text-cyan-400 mono">72.1s</span>
        <span class="absolute top-2 right-2 bg-emerald-500/80 px-2 py-0.5 rounded text-[10px] font-bold text-white">44.0 MB</span>
      </div>
      <h3 class="font-bold text-sm text-white leading-snug">19 January 2038: The Day Internet Might Die! ⚠️ #Shorts</h3>
      <p class="text-xs text-slate-400 mt-2 line-clamp-2">Unix Epoch 32-bit integer overflow bug documentary. 80%+ audience retention flow.</p>
    </div>
    <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between">
      <a href="/video" download="y2k38_short.mp4" class="liquid-pill px-3 py-1.5 rounded-xl text-xs font-semibold text-cyan-300 flex items-center gap-1">
        <span>💾</span> Download
      </a>
      <button onclick="playVaultVideo('/video', '19 January 2038: The Day Internet Might Die!')" class="liquid-pill px-3 py-1.5 rounded-xl text-xs font-semibold text-white flex items-center gap-1">
        <span>▶️</span> Play
      </button>
    </div>
  </div>

</div>
