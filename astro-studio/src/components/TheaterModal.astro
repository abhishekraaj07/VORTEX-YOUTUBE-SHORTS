---
// TheaterModal.astro - 9:16 Video Player Theater Modal
---
<div id="theaterModal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-2xl hidden items-center justify-center p-4">
  <div class="relative w-full max-w-sm flex flex-col items-center">
    <button onclick="closeTheater()" class="absolute -top-12 right-0 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center text-lg">
      ✕
    </button>
    <div class="w-[320px] h-[600px] rounded-3xl overflow-hidden border border-white/20 shadow-2xl bg-black">
      <video id="theaterPlayer" controls autoplay loop class="w-full h-full object-cover"></video>
    </div>
    <h3 id="theaterTitle" class="text-sm font-bold text-white text-center mt-4"></h3>
  </div>
</div>
