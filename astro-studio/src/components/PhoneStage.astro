---
// PhoneStage.astro - VisionOS 3D Phone Stage & Active Video Metadata
---
<div class="lg:col-span-5 flex flex-col items-center gap-6">

  <!-- VisionOS Spatial Phone Mockup -->
  <div class="phone-stage">
    <div class="dynamic-island"></div>

    <!-- Top Overlay -->
    <div class="absolute top-12 left-4 right-4 flex justify-between items-center z-30 pointer-events-none">
      <span class="bg-black/60 backdrop-blur-md px-2.5 py-1 rounded-full text-[9px] text-cyan-300 mono border border-cyan-500/30">
        1080x1920 • 30 FPS
      </span>
      <span class="bg-red-600/90 backdrop-blur-md px-2.5 py-1 rounded-full text-[9px] font-black text-white uppercase tracking-wider">
        SHORTS
      </span>
    </div>

    <!-- Video Stream Element -->
    <video id="studioVideoPlayer" controls autoplay loop playsinline class="w-full h-full object-cover">
      <source src="/video" type="video/mp4">
      Your browser does not support HTML5 video.
    </video>

    <!-- Safety Zone Marker (Bottom 25% UI Safe Area) -->
    <div class="absolute bottom-4 left-4 right-4 z-30 pointer-events-none flex justify-between items-end">
      <div class="space-y-1">
        <span class="bg-black/70 backdrop-blur-sm px-2 py-0.5 rounded text-[9px] text-emerald-400 border border-emerald-500/30 font-semibold">
          🛡️ AI Disclosure Active
        </span>
        <div class="text-[10px] text-white font-bold drop-shadow">#VortexShorts #TechMysteries</div>
      </div>
      <button onclick="downloadActiveVideo()" class="pointer-events-auto w-9 h-9 rounded-full bg-white/20 hover:bg-white/30 backdrop-blur-md flex items-center justify-center text-white text-sm border border-white/20 shadow-lg">
        💾
      </button>
    </div>
  </div>

  <!-- Metadata & Action Capsule -->
  <div class="liquid-glass w-full p-5 rounded-3xl text-xs space-y-3">
    <div class="flex items-center justify-between border-b border-white/10 pb-2">
      <span class="text-slate-400 font-semibold">Active Short Spec</span>
      <span class="text-cyan-400 mono font-semibold" id="activeMetaDuration">72.1s • 44.0 MB</span>
    </div>
    <div>
      <span class="text-slate-400 block mb-1 text-[11px]">YouTube Title:</span>
      <div id="metaTitle" class="font-bold text-slate-100 bg-slate-900/80 p-2.5 rounded-xl border border-white/10 select-text">
        19 January 2038: The Day Internet Might Die! ⚠️ #Shorts
      </div>
    </div>
    <div class="flex gap-2">
      <button onclick="copyMetadata()" class="flex-1 py-2 rounded-xl liquid-pill text-xs font-semibold text-cyan-300 flex items-center justify-center gap-1.5">
        <span>📋</span> Copy Title & Tags
      </button>
      <button onclick="switchView('publish')" class="flex-1 py-2 rounded-xl bg-indigo-600/30 hover:bg-indigo-600/50 border border-indigo-500/40 text-xs font-semibold text-indigo-200 flex items-center justify-center gap-1.5">
        <span>🚀</span> Publish Station
      </button>
    </div>
  </div>

</div>
